# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Agent worktrees (temporary, created/removed by the Agent tool)
.claude/worktrees/

# Pipeline run output (data/executions/ holds the per-run execution folders
# and the rebuilt index); keep the input/ folder tracked since config.py points
# the pipeline at it.
/data/*
!/data/input/
